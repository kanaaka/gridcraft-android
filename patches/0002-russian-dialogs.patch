+#[cfg(test)]
+mod russian_dialog_tests {
+    use super::*;
+
+    fn dialog_text(name: &str) -> (Vec<String>, crate::SheetApp) {
+        let mut app = crate::SheetApp::new(gridcraft_engine::Session::new(), Default::default());
+        app.run("file.new", serde_json::json!({})).unwrap();
+        app.ui.language = Language::Ru;
+        app.open_dialog(name, serde_json::json!({}));
+        let ctx = egui::Context::default();
+        set_current(&ctx, Language::Ru);
+        let mut texts = Vec::new();
+        fn collect(shape: &egui::epaint::Shape, texts: &mut Vec<String>) {
+            match shape {
+                egui::epaint::Shape::Text(t) => texts.push(t.galley.text().to_string()),
+                egui::epaint::Shape::Vec(shapes) => {
+                    for s in shapes { collect(s, texts); }
+                }
+                _ => {}
+            }
+        }
+        for _ in 0..3 {
+            let mut output = ctx.run_ui(egui::RawInput::default(), |ui| crate::dialogs::show(&mut app, ui.ctx()));
+            output.textures_delta.clear();
+            for shape in output.shapes { collect(&shape.shape, &mut texts); }
+        }
+        (texts, app)
+    }
+
+    #[test]
+    fn russian_dialog_captions_keep_command_values_intact() {
+        let (texts, app) = dialog_text("insertCells");
+        for caption in ["Вставить", "Со сдвигом ячеек вниз", "Столбец целиком", "ОК", "Отмена"] {
+            assert!(texts.iter().any(|s| s == caption), "missing {caption}: {texts:?}");
+        }
+        assert_eq!(app.dialog.as_ref().unwrap().values["shift"], "down");
+        let (texts, _) = dialog_text("find");
+        for caption in ["Найти:", "Учитывать регистр", "Найти далее"] {
+            assert!(texts.iter().any(|s| s == caption), "missing {caption}: {texts:?}");
+        }
+        assert_eq!(Language::En.tr("Cancel"), "Cancel");
+        assert_eq!(Language::Ru.tr("Sheet1!A1"), "Sheet1!A1");
+    }
+}
