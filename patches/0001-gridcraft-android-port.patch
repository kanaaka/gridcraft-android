+fn format_painter_picks_up_and_applies_to_a_target_range() {
+    let mut s = s();
+    s.execute("home.bold", json!({"range": "A1", "on": true})).unwrap();
+    s.execute("home.formatCells", json!({"range": "A1", "style": {"num_fmt": "\"$\"#,##0.00"}})).unwrap();
+    // Nothing picked up: there is no format to paste.
+    assert!(s.execute("edit.formatPainter", json!({"apply": "C3:D4"})).is_err());
+    // Pick up the selection's format, then paste it over a target range (the source tiles over it).
+    s.execute("selection.set", json!({"range": "A1"})).unwrap();
+    s.execute("edit.formatPainter", json!({})).unwrap();
+    s.execute("edit.formatPainter", json!({"apply": "C3:D4"})).unwrap();
+    {
+        let d = s.doc().unwrap();
+        let sh = d.wb.active().unwrap();
+        let src = sh.style_id(CellRef::parse("A1").unwrap());
+        assert!(d.wb.styles.get(src).font.bold);
+        for cell in ["C3", "D3", "C4", "D4"] {
+            assert_eq!(sh.style_id(CellRef::parse(cell).unwrap()), src, "{cell}");
+        }
