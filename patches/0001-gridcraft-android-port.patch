+/// The number format of a range's last numeric cell, scanning up from its bottom-right corner.
+/// Excel's AutoSum writes its total with the number format of the cells it added up, so a currency
+/// column sums to a currency total. `None` when that cell is unformatted (`General`), leaving the
+/// total's own style alone rather than inventing a format.
+fn auto_sum_num_fmt(wb: &Workbook, sh: &Sheet, r: RangeRef) -> Option<NumFmt> {
+    for row in (r.start.row..=r.end.row).rev() {
+        for col in (r.start.col..=r.end.col).rev() {
+            let c = CellRef::new(row, col);
+            if sh.value(c).is_number() {
+                let nf = wb.styles.get(sh.style_id(c)).num_fmt.clone();
+                return (nf.as_str() != "General").then_some(nf);
+            }
+        }
+    }
+    None
+}
+
+/// Puts each total's source number format onto the total cell's *own* style, keeping the font,
+/// fill and borders AutoSum wrote there: only the number format follows the data, as in Excel.
+fn set_auto_sum_formats(s: &mut Session, sheet: usize, formats: Vec<(CellRef, NumFmt)>) -> Result<()> {
+    if formats.is_empty() {
+        return Ok(());
+    }
+    edit(s, |cx| {
+        for (c, nf) in formats {
+            let cur = cx.wb.sheet(sheet).map(|sh| sh.style_id(c)).unwrap_or_default();
+            let st = cx.wb.styles.derive(cur, |s| s.num_fmt = nf.clone());
+            cx.sheet_mut(sheet)?.set_style(c, st);
+            cx.touch(sheet, c);
+        }
+        Ok(())
+    })
+}
